#!/bin/sh
# Lanzador: funciona desde el repositorio o instalado en /app (Flatpak) / ~/.local.
here="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
for base in "$here/.." "$here/../share/hasu"; do
    if [ -d "$base/hasu" ]; then
        PYTHONPATH="$base${PYTHONPATH:+:$PYTHONPATH}" exec python3 -m hasu "$@"
    fi
done
echo "No encuentro el paquete hasu" >&2
exit 1
